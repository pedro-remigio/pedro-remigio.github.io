# Copie este arquivo para ".env" antes de rodar "docker compose up -d --build".
# NUNCA commite o arquivo ".env" — ele contém senhas reais.

# ─── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-por-algo-forte
POSTGRES_DB=remigio_eventos

# ─── Sessão ───────────────────────────────────────────────────────────────────
# Gere uma string aleatória longa (ex: rode no terminal: openssl rand -hex 32)
SESSION_SECRET=troque-este-valor-por-uma-string-aleatoria-longa

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@remigioeventos.com
ADMIN_PASSWORD=troque-esta-senha

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL do frontend que tem permissão de chamar a API com cookies
FRONTEND_URL=https://eventos.pedroremigio.com.br

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Obtenha em: mercadopago.com.br/developers/panel/app
# Teste:    TEST-xxxx   |   Produção: APP_USR-xxxx
MP_ACCESS_TOKEN=TEST-cole-seu-access-token-aqui

# Assinatura secreta do webhook (gerada no painel do MP → Webhooks)
MP_WEBHOOK_SECRET=cole-sua-assinatura-secreta-aqui

# URL pública do backend (para o webhook do Mercado Pago notificar pagamentos)
BACKEND_URL=https://apieventos.pedroremigio.com.br

# ─── Ambiente ─────────────────────────────────────────────────────────────────
# "production" ativa cookies seguros (HTTPS obrigatório)
# "development" para testes locais com Docker
NODE_ENV=production
