DATABASE_URL="postgresql://usuario:senha@localhost:5432/remigio_eventos?schema=public"

PORT=3000

SESSION_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"

ADMIN_EMAIL="admin@remigioeventos.com"
ADMIN_PASSWORD="troque-esta-senha"

# URL do front-end (GitHub Pages) — necessário para o CORS em produção
# Em desenvolvimento pode ficar vazio ou ser http://localhost:5500
FRONTEND_URL="https://eventos.pedroremigio.com.br"

# URL pública do backend (usada para gerar o webhook do Mercado Pago)
BACKEND_URL="https://apieventos.pedroremigio.com.br"

# Mercado Pago — Access Token
# Teste:    começa com TEST-   (obtenha em mercadopago.com.br/developers/panel/app)
# Produção: começa com APP_USR- (só usar quando o app for aprovado no MP)
MP_ACCESS_TOKEN="TEST-cole-seu-access-token-aqui"

# Defina como "production" no servidor AWS para ativar cookies seguros (HTTPS)
NODE_ENV="development"
