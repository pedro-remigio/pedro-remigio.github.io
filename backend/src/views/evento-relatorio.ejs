<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Relatório — <%= evento.titulo %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800">

  <header class="bg-black text-white shadow-lg">
    <div class="container mx-auto flex items-center justify-between p-4">
      <div>
        <a href="/admin/dashboard" class="text-gray-400 hover:text-white text-sm transition">← Painel</a>
        <h1 class="font-bold text-xl mt-1">Relatório do Evento</h1>
      </div>
      <a href="/admin/logout" class="bg-gray-900 hover:bg-red-600 transition px-4 py-2 rounded-lg text-sm">Sair</a>
    </div>
  </header>

  <main class="container mx-auto py-10 px-6 space-y-8">

    <!-- CABEÇALHO DO EVENTO -->
    <section class="bg-white rounded-2xl shadow-lg overflow-hidden">

      <% if (evento.imagem) { %>
        <img src="<%= evento.imagem %>" alt="<%= evento.titulo %>"
          class="w-full h-48 object-cover">
      <% } %>

      <div class="p-6">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div>
            <h2 class="text-3xl font-bold mb-1"><%= evento.titulo %></h2>
            <p class="text-gray-500 text-sm">
              📅 <%= new Date(evento.data).toLocaleDateString("pt-BR", { weekday: "long", day: "2-digit", month: "long", year: "numeric" }) %>
              &nbsp;·&nbsp;
              📍 <%= evento.local %>
            </p>
          </div>
          <span class="px-3 py-1 rounded-full text-sm font-semibold flex-shrink-0
            <%= evento.status === 'ativo' ? 'bg-green-100 text-green-700' : evento.status === 'encerrado' ? 'bg-gray-200 text-gray-600' : 'bg-red-100 text-red-600' %>">
            <%= evento.status %>
          </span>
        </div>

        <div class="flex gap-6 mt-4 text-sm text-gray-600 flex-wrap">
          <span>🎟️ Capacidade: <strong><%= evento.capacidade %> vagas</strong></span>
          <span>💰 Preço: <strong><%= evento.preco != null ? "R$ " + evento.preco.toFixed(2).replace(".", ",") : "Gratuito" %></strong></span>
        </div>
      </div>

    </section>

    <!-- CARDS DE ESTATÍSTICAS -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4">

      <div class="bg-white rounded-xl shadow p-5 text-center">
        <p class="text-4xl font-bold text-blue-600"><%= total %></p>
        <p class="text-gray-500 mt-1 text-sm">Total de inscrições</p>
      </div>

      <div class="bg-white rounded-xl shadow p-5 text-center">
        <p class="text-4xl font-bold text-green-600"><%= confirmadas %></p>
        <p class="text-gray-500 mt-1 text-sm">Confirmadas</p>
      </div>

      <div class="bg-white rounded-xl shadow p-5 text-center">
        <p class="text-4xl font-bold text-yellow-500"><%= pendentes %></p>
        <p class="text-gray-500 mt-1 text-sm">Pendentes</p>
      </div>

      <div class="bg-white rounded-xl shadow p-5 text-center">
        <p class="text-4xl font-bold text-gray-400"><%= canceladas %></p>
        <p class="text-gray-500 mt-1 text-sm">Canceladas</p>
      </div>

    </section>

    <!-- VALOR ARRECADADO -->
    <% if (valorArrecadado !== null) { %>
      <section class="bg-gradient-to-r from-green-600 to-green-700 text-white rounded-2xl shadow-lg p-6 flex items-center justify-between flex-wrap gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide opacity-80">Valor arrecadado (inscrições confirmadas)</p>
          <p class="text-4xl font-bold mt-1">
            R$ <%= valorArrecadado.toFixed(2).replace(".", ",") %>
          </p>
        </div>
        <div class="text-right text-sm opacity-80">
          <p><%= confirmadas %> × R$ <%= evento.preco.toFixed(2).replace(".", ",") %></p>
          <% const vagas_livres = evento.capacidade - total; %>
          <p class="mt-1"><%= vagas_livres > 0 ? vagas_livres + " vaga(s) restante(s)" : "Evento lotado" %></p>
        </div>
      </section>
    <% } else { %>
      <section class="bg-blue-50 border border-blue-200 rounded-2xl p-5 text-blue-800 text-sm">
        🎟️ Evento gratuito — <strong><%= total %></strong> participante(s) inscrito(s).
        <% const vagas_livres = evento.capacidade - total; %>
        <span class="ml-2"><%= vagas_livres > 0 ? vagas_livres + " vaga(s) restante(s)." : "Evento lotado." %></span>
      </section>
    <% } %>

    <!-- TABELA DE PARTICIPANTES -->
    <section>
      <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <h3 class="text-xl font-bold">Lista de Participantes</h3>
        <a href="/admin/eventos/<%= evento.id %>/editar"
          class="bg-yellow-400 hover:bg-yellow-500 transition text-black px-4 py-2 rounded-lg text-sm font-semibold">
          ✏️ Editar evento
        </a>
      </div>

      <div class="bg-white rounded-xl shadow-lg overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-gray-900 text-white">
            <tr>
              <th class="p-3">#</th>
              <th class="p-3">Nome</th>
              <th class="p-3">Email</th>
              <th class="p-3">CPF / Doc.</th>
              <th class="p-3">Telefone</th>
              <th class="p-3">Status</th>
              <th class="p-3">ID Pagamento</th>
              <th class="p-3">Inscrito em</th>
            </tr>
          </thead>
          <tbody>
            <% if (evento.inscricoes.length === 0) { %>
              <tr>
                <td class="p-4 text-gray-400 text-center" colspan="8">
                  Nenhuma inscrição ainda.
                </td>
              </tr>
            <% } %>
            <% evento.inscricoes.forEach((ins, idx) => { %>
              <tr class="border-t border-gray-100 hover:bg-gray-50">
                <td class="p-3 text-gray-400"><%= idx + 1 %></td>
                <td class="p-3 font-semibold"><%= ins.usuario.nome %></td>
                <td class="p-3"><%= ins.usuario.email %></td>
                <td class="p-3 font-mono text-xs"><%= ins.usuario.cpf || "—" %></td>
                <td class="p-3"><%= ins.usuario.telefone || "—" %></td>
                <td class="p-3">
                  <span class="px-2 py-1 rounded-full text-xs font-semibold
                    <%= ins.status === 'confirmada' ? 'bg-green-100 text-green-700' :
                        ins.status === 'pendente'   ? 'bg-yellow-100 text-yellow-700' :
                                                      'bg-gray-100 text-gray-500' %>">
                    <%= ins.status %>
                  </span>
                </td>
                <td class="p-3 text-xs font-mono text-gray-400">
                  <%= ins.pagamentoId || "—" %>
                </td>
                <td class="p-3 text-gray-500"><%= ins.createdAt.toLocaleString("pt-BR") %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    </section>

  </main>

</body>
</html>
